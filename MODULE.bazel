module(name = "mono")

bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.45.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.4")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//.buildkite/gen:go.mod")
use_repo(go_deps, "com_github_buildkite_buildkite_sdk_sdk_go")
